# Copy to .env and set a database password before `docker compose up`.
# Use letters and digits only (it is placed inside a connection URL).
POSTGRES_PASSWORD=change-me

# Port the app is published on.
PORT=8000

# Only used the first time, when the database is empty, to create the administrator.
# You are forced to change this password at first sign-in.
PM_ADMIN_USERNAME=admin
PM_ADMIN_PASSWORD=Admin@123
PM_ADMIN_EMAIL=admin@example.com

# Optional. Leave empty to have a signing key generated and kept in the app_data volume.
PM_SECRET_KEY=
